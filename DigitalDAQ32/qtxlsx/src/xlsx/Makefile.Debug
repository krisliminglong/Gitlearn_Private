	E:\Qt\Qt5.12.9\5.12.9\mingw73_32\bin\qtattributionsscanner.exe F:/BaiduNetdiskDownload/QtXlsxWriter-master --filter QDocModule=qtxlsx -o F:/BaiduNetdiskDownload/QtXlsxWriter-master/src/xlsx/codeattributions.qdoc

